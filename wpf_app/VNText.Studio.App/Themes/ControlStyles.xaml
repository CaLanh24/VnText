<!-- Styles adapted from VNText_Studio_GUI/App.xaml (read-only reference, 2026-08-29) -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:VNText.Studio.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">



    <!-- Shared outer card: bounded neutral edge and soft elevation approximation. -->
    <Style x:Key="CardShadowBorder" TargetType="Border">

        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />

        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="{StaticResource UiCardRadius}" />

        <Setter Property="Padding" Value="{StaticResource UiCardPadding}" />

        <Setter Property="Effect" Value="{StaticResource UiCardShadow}" />

        <Setter Property="SnapsToDevicePixels" Value="True" />

    </Style>



    <Style x:Key="SubtlePanelBorder" TargetType="Border">

        <Setter Property="Background" Value="Transparent" />

        <Setter Property="CornerRadius" Value="0" />

        <Setter Property="Padding" Value="10,8" />

    </Style>



    <Style x:Key="ChecklistPanelBorder" TargetType="Border">

        <Setter Property="Background" Value="{DynamicResource SubtlePanelBrush}" />

        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="12" />

        <Setter Property="Padding" Value="13,12" />

    </Style>

    <Style x:Key="UiPageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiPageTitleSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
    </Style>

    <Style x:Key="UiSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiSectionTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="UiRowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiRowTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="UiBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="{StaticResource UiBodySize}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style x:Key="UiSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiSecondarySize}" />
        <Setter Property="Foreground" Value="#657286" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="UiCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiCaptionSize}" />
        <Setter Property="Foreground" Value="#657286" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="UiSectionMarkerTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiSectionMarkerSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Shared Settings header and row primitives; no per-tab header copies. -->
    <Style x:Key="StandardPageHeaderStyle" TargetType="Grid">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="settings">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingsPageHeaderTextStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="{Binding HeroTitle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}">
                            <Run Text="Workspace  /  " /><Run Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource UiPageTitleTextStyle}" Margin="0,9,0,0" />
                        <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource UiBodyTextStyle}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,16,0" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DropShadowEffect x:Key="SettingsSegmentedShadow" Color="#445065" BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.18" />
    <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardShadowBorder}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="SettingsRowHelperTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource UiCaptionSize}" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingsRowLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource UiBodySize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style x:Key="SettingsSelectFocusVisualStyle" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
            <Border BorderBrush="{DynamicResource BlueBrush}" BorderThickness="2" CornerRadius="9" Margin="-2" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="Margin" Value="8,0" />
    </Style>
    <Style x:Key="SettingsDataRowStyle" TargetType="Grid" BasedOn="{StaticResource SettingsRowStyle}">
        <Setter Property="MinHeight" Value="88" />
    </Style>
    <Style x:Key="SettingsRowSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsRowHoverBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingsDividerRowStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SettingsSectionHeaderStyle" TargetType="{x:Type HeaderedContentControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="{StaticResource UiSectionMarkerWidth}" Background="{DynamicResource BlueBrush}"
                                CornerRadius="2" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                   Style="{StaticResource UiSectionTitleTextStyle}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsTabKeyboardFocusVisualStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Margin="1,2" Background="Transparent" BorderBrush="{DynamicResource BlueBrush}"
                            BorderThickness="1" CornerRadius="11" Opacity="0.55" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="KeyboardFocusStyle" TargetType="{x:Type Control}">

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Control}">

                    <Border BorderBrush="{DynamicResource BlueBrush}" BorderThickness="2" CornerRadius="10" />

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="ExtractionProgressBarStyle" TargetType="{x:Type ProgressBar}">

        <Setter Property="Height" Value="8" />

        <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />

        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ProgressBar}">

                    <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">

                        <Grid x:Name="PART_Track" ClipToBounds="True">

                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"

                                    CornerRadius="4" HorizontalAlignment="Left" />

                        </Grid>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="BlueProgressBarStyle" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource ExtractionProgressBarStyle}">

        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />

    </Style>



    <Style x:Key="PurpleProgressBarStyle" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource ExtractionProgressBarStyle}">

        <Setter Property="Foreground" Value="{DynamicResource PurpleBrush}" />

    </Style>



    <Style x:Key="ScrollBarButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin pill scrollbar: invisible until hover/drag (or code flashes Opacity on scroll). -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollBarButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Background="{TemplateBinding Foreground}" MinWidth="0" MinHeight="24" FocusVisualStyle="{x:Null}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbSurface"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="100"
                                                    Margin="2,1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollBarButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Thumb" Property="Height" Value="10" />
                            <Setter TargetName="PART_Thumb" Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Thumb" Property="MinHeight" Value="0" />
                            <Setter TargetName="PART_Thumb" Property="MinWidth" Value="24" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="10" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter TargetName="PART_Thumb" Property="Width" Value="10" />
                            <Setter TargetName="PART_Thumb" Property="Height" Value="Auto" />
                            <Setter TargetName="PART_Thumb" Property="MinWidth" Value="0" />
                            <Setter TargetName="PART_Thumb" Property="MinHeight" Value="24" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Maximum" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseCaptureWithin" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Overlay: no reserved gutter; bar sits on content and stays Opacity 0 until hover/scroll flash. -->
    <Style x:Key="OverlayAutoHideScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Width="10"
                                   Margin="0,2,1,2" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Height="10"
                                   Margin="2,0,2,1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">

        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="MinHeight" Value="{StaticResource UiNavRowHeight}" />

        <Setter Property="Padding" Value="12,6" />

        <Setter Property="Margin" Value="0,0,0,5" />

        <Setter Property="FontSize" Value="13.5" />

        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />

        <Setter Property="FontWeight" Value="Medium" />

        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="{StaticResource UiNavRadius}">

                        <ContentPresenter Margin="{TemplateBinding Padding}"

                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="Tag"><Condition.Value><sys:Boolean>False</sys:Boolean></Condition.Value></Condition></MultiTrigger.Conditions>

                            <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontWeight" Value="Medium" />

                        </MultiTrigger>

                        <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NavActiveBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource NavActiveForegroundBrush}" /><Setter Property="FontWeight" Value="Medium" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">

                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="GuiOutlineButtonStyle" TargetType="{x:Type Button}">

        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />

        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />

        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="MinHeight" Value="30" />

        <Setter Property="MinWidth" Value="68" />

        <Setter Property="Padding" Value="12,6" />

        <Setter Property="FontSize" Value="13" />

        <Setter Property="FontWeight" Value="Normal" />

        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"

                            CornerRadius="{StaticResource UiControlRadius}">

                        <ContentPresenter Margin="{TemplateBinding Padding}"

                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource LineBrush}" />

                            <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SettingsPreferenceFieldBrush}" />

                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">

                            <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource NavPressedBrush}" />

                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />

                            <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />

                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="GuiPrimaryButtonStyle" TargetType="{x:Type Button}">

        <Setter Property="Background" Value="{DynamicResource BlueBrush}" />

        <Setter Property="Foreground" Value="White" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="MinHeight" Value="34" />

        <Setter Property="MinWidth" Value="112" />

        <Setter Property="Padding" Value="14,7" />

        <Setter Property="FontSize" Value="14" />

        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="PrimarySurface" Background="{TemplateBinding Background}" CornerRadius="{StaticResource UiControlRadius}">

                        <ContentPresenter Margin="{TemplateBinding Padding}"

                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="PrimarySurface" Property="Background" Value="{DynamicResource BlueHoverBrush}" />

                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">

                            <Setter TargetName="PrimarySurface" Property="Background" Value="{DynamicResource BlueHoverBrush}" />

                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter TargetName="PrimarySurface" Property="Background" Value="{DynamicResource DisabledPrimaryBackgroundBrush}" />

                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="GuiBluePrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GuiPrimaryButtonStyle}">

        <Setter Property="Background" Value="{DynamicResource BlueBrush}" />

        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">

                <Setter Property="Background" Value="{DynamicResource BlueHoverBrush}" />

            </Trigger>

            <Trigger Property="IsEnabled" Value="False">

                <Setter Property="Background" Value="{DynamicResource BlueSoftBrush}" />

                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />

            </Trigger>

        </Style.Triggers>

    </Style>



    <Style x:Key="FieldTextBoxStyle" TargetType="{x:Type TextBox}">

        <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}" />

        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />

        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="Padding" Value="10,6" />

        <Setter Property="FontSize" Value="13" />

        <Setter Property="Height" Value="{StaticResource UiControlHeight}" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type TextBox}">

                    <Border x:Name="FieldSurface" Background="{TemplateBinding Background}"

                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"

                            CornerRadius="9">

                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Foreground="{TemplateBinding Foreground}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">

                            <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource BlueBrush}" />

                            <Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />

                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />

                            <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />

                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <Style x:Key="CompactFieldTextBoxStyle" TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource FieldTextBoxStyle}">

        <Setter Property="Height" Value="32" />

        <Setter Property="Padding" Value="12,4" />

    </Style>



    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">

        <Border x:Name="ComboToggleSurface" Background="{TemplateBinding Background}"

                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"

                CornerRadius="9">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="28" />

                </Grid.ColumnDefinitions>

                <Path Grid.Column="1" Data="M8,9 L12,13 L16,9" Stroke="{DynamicResource MutedBrush}"

                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"

                      HorizontalAlignment="Center" VerticalAlignment="Center" />

            </Grid>

        </Border>

        <ControlTemplate.Triggers>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboToggleSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />

                <Setter TargetName="ComboToggleSurface" Property="BorderBrush" Value="{DynamicResource SettingsPreferenceBorderBrush}" />

            </Trigger>

            <Trigger Property="IsChecked" Value="True">

                <Setter TargetName="ComboToggleSurface" Property="BorderBrush" Value="{DynamicResource SettingsPreferenceBorderBrush}" />

                <Setter TargetName="ComboToggleSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />

            </Trigger>

            <Trigger Property="IsEnabled" Value="False">

                <Setter TargetName="ComboToggleSurface" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />

                <Setter TargetName="ComboToggleSurface" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />

            </Trigger>

        </ControlTemplate.Triggers>

    </ControlTemplate>



    <Style x:Key="SettingsComboItem" TargetType="{x:Type ComboBoxItem}">

        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Padding" Value="12,5" />

        <Setter Property="FontSize" Value="13" />

        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />

        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                    <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">

