<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Core palette (VNTextReplica / GUI reference) -->

    <Color x:Key="CanvasColor">#F2F6FC</Color>

    <Color x:Key="SurfaceColor">#FFFFFF</Color>

    <Color x:Key="InkColor">#111827</Color>

    <Color x:Key="MutedColor">#4B5B71</Color>

    <Color x:Key="SoftTextColor">#94A3B8</Color>

    <Color x:Key="LineColor">#E5E7EB</Color>



    <Color x:Key="GreenColor">#12C96B</Color>

    <Color x:Key="GreenDarkColor">#087C42</Color>

    <Color x:Key="GreenSoftColor">#E6FAEF</Color>

    <Color x:Key="GreenHoverColor">#0BAF5C</Color>

    <Color x:Key="NavActiveBackgroundColor">#D7DFF6</Color>



    <Color x:Key="BlueColor">#2868E8</Color>

    <Color x:Key="BlueSoftColor">#E9F1FF</Color>

    <Color x:Key="BlueHoverColor">#1F58CE</Color>



    <Color x:Key="WarningColor">#B56D00</Color>

    <Color x:Key="WarningSoftColor">#FFF4DF</Color>



    <Color x:Key="ErrorColor">#C84040</Color>

    <Color x:Key="ErrorSoftColor">#FFF0F0</Color>



    <Color x:Key="PurpleAccentColor">#8255D5</Color>

    <Color x:Key="PurpleSoftColor">#F3EEFF</Color>



    <sys:Double x:Key="UiBodySize">14</sys:Double>
    <sys:Double x:Key="UiCaptionSize">12</sys:Double>
    <sys:Double x:Key="UiSectionTitleSize">16</sys:Double>
    <sys:Double x:Key="UiPageTitleSize">26</sys:Double>
    <sys:Double x:Key="UiRowTitleSize">14</sys:Double>
    <sys:Double x:Key="UiSecondarySize">12</sys:Double>

    <GridLength x:Key="UiSidebarWidth">206</GridLength>
    <Thickness x:Key="UiPageInset">24,0,24,30</Thickness>
    <Thickness x:Key="UiSidebarInset">16</Thickness>
    <sys:Double x:Key="UiNavRowHeight">44</sys:Double>
    <CornerRadius x:Key="UiNavRadius">10</CornerRadius>
    <CornerRadius x:Key="UiCardRadius">18</CornerRadius>
    <Thickness x:Key="UiCardPadding">24,20</Thickness>
    <sys:Double x:Key="UiControlHeight">34</sys:Double>
    <sys:Double x:Key="UiCompactControlHeight">32</sys:Double>
    <CornerRadius x:Key="UiControlRadius">10</CornerRadius>
    <Thickness x:Key="UiSectionTopGap">0,16,0,0</Thickness>
    <sys:Double x:Key="UiSectionMarkerSize">12</sys:Double>
    <sys:Double x:Key="UiSectionMarkerWidth">3</sys:Double>

    <!-- Surfaces & chrome -->

    <Color x:Key="FieldBackgroundColor">#FBFCFF</Color>

    <Color x:Key="SubtlePanelColor">#F7F9FD</Color>

    <Color x:Key="LogPanelColor">#F8FAFD</Color>

    <Color x:Key="PillBackgroundColor">#F1F3F6</Color>

    <Color x:Key="ProjectCardColor">#F3F7FC</Color>

    <Color x:Key="TableHeaderColor">#F0F4FA</Color>

    <Color x:Key="ProgressTrackColor">#E8EEF6</Color>

    <Color x:Key="BrandDarkColor">#253047</Color>

    <Color x:Key="NavHoverColor">#F0F5FC</Color>

    <Color x:Key="NavPressedColor">#E8EFF9</Color>

    <Color x:Key="DotRingColor">#C7C7CC</Color>

    <Color x:Key="ShadowColor">#445065</Color>



    <!-- Disabled (readable, not opacity-faded) -->

    <Color x:Key="DisabledBackgroundColor">#F3F5F8</Color>

    <Color x:Key="DisabledBorderColor">#E0E4EB</Color>

    <Color x:Key="DisabledForegroundColor">#9AA3B2</Color>

    <Color x:Key="DisabledPrimaryBackgroundColor">#D7E3FA</Color>



    <!-- Scrollbar -->

    <Color x:Key="ScrollTrackColor">#00FFFFFF</Color>

    <Color x:Key="ScrollThumbColor">#B8C1CE</Color>

    <Color x:Key="ScrollThumbHoverColor">#8D99AA</Color>



    <!-- Bounded visual approximation; not recovered Cockpit shadow tokens. -->
    <DropShadowEffect x:Key="UiCardShadow" Color="{StaticResource ShadowColor}"
                      BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.10" />

    <!-- Legacy aliases -->

    <Color x:Key="WindowColor">#F6F7FB</Color>

    <Color x:Key="SidebarColor">#E1E5F1</Color>

    <Color x:Key="BorderColor">#E7E9EE</Color>

    <Color x:Key="CardBorderColor">#E5E7ED</Color>

    <Color x:Key="AccentColor">#2868E8</Color>

    <Color x:Key="AccentSubtleColor">#E9F1FF</Color>

    <Color x:Key="SuccessColor">#12C96B</Color>

    <Color x:Key="CtrlBorderColor">#E7E9EE</Color>

    <Color x:Key="TextTerColor">#A1A7B2</Color>

    <Color x:Key="TextPrimaryColor">#20242D</Color>

    <Color x:Key="TextSecondaryColor">#7D8492</Color>

    <Color x:Key="TextMutedColor">#7D8492</Color>

    <Color x:Key="SwitchOffColor">#D5D9E1</Color>



    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />

    <LinearGradientBrush x:Key="SettingsTitleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2563EB" Offset="0" /><GradientStop Color="#089DB2" Offset="1" />
    </LinearGradientBrush>
    <!-- Upper blue/cyan light fades vertically into a neutral lower canvas. -->
    <DrawingBrush x:Key="WorkspaceCanvasBrush" Stretch="Fill">
        <DrawingBrush.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#EFF2F7" Geometry="M0,0 H1 V1 H0 Z" />
            <DrawingGroup>
                <DrawingGroup.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="White" Offset="0" /><GradientStop Color="White" Offset="0.207" />
                    <GradientStop Color="#00FFFFFF" Offset="0.828" /><GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush></DrawingGroup.OpacityMask>
                <GeometryDrawing Geometry="M0,0 H1 V1 H0 Z"><GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#D3DBF2" Offset="0" /><GradientStop Color="#F3F3F4" Offset="0.48" />
                        <GradientStop Color="#DFEEED" Offset="0.9" /><GradientStop Color="#E2EFEE" Offset="1" />
                    </LinearGradientBrush>
                </GeometryDrawing.Brush></GeometryDrawing>
            </DrawingGroup>
        </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />

    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

    <SolidColorBrush x:Key="SoftTextBrush" Color="{StaticResource SoftTextColor}" />

    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />



    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />

    <SolidColorBrush x:Key="GreenDarkBrush" Color="{StaticResource GreenDarkColor}" />

    <SolidColorBrush x:Key="GreenSoftBrush" Color="{StaticResource GreenSoftColor}" />

    <SolidColorBrush x:Key="GreenHoverBrush" Color="{StaticResource GreenHoverColor}" />

    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="{StaticResource NavActiveBackgroundColor}" />



    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />

    <SolidColorBrush x:Key="BlueSoftBrush" Color="{StaticResource BlueSoftColor}" />

    <SolidColorBrush x:Key="BlueHoverBrush" Color="{StaticResource BlueHoverColor}" />



    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />



    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />



    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleAccentColor}" />

    <SolidColorBrush x:Key="PurpleSoftBrush" Color="{StaticResource PurpleSoftColor}" />



    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="{StaticResource FieldBackgroundColor}" />

    <SolidColorBrush x:Key="SubtlePanelBrush" Color="{StaticResource SubtlePanelColor}" />

    <SolidColorBrush x:Key="LogPanelBrush" Color="{StaticResource LogPanelColor}" />

    <SolidColorBrush x:Key="PillBackgroundBrush" Color="{StaticResource PillBackgroundColor}" />

    <SolidColorBrush x:Key="ProjectCardBrush" Color="{StaticResource ProjectCardColor}" />

    <SolidColorBrush x:Key="TableHeaderBrush" Color="{StaticResource TableHeaderColor}" />

    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}" />

    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />

    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}" />

    <SolidColorBrush x:Key="NavPressedBrush" Color="{StaticResource NavPressedColor}" />

    <SolidColorBrush x:Key="DotRingBrush" Color="{StaticResource DotRingColor}" />



    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}" />

    <SolidColorBrush x:Key="DisabledBorderBrush" Color="{StaticResource DisabledBorderColor}" />

    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />

    <SolidColorBrush x:Key="DisabledPrimaryBackgroundBrush" Color="{StaticResource DisabledPrimaryBackgroundColor}" />



    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />



    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E1E5F1" Offset="0" /><GradientStop Color="#E9EDF4" Offset="0.55" /><GradientStop Color="#F0F4F7" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsRowHoverBrush" Color="#F0F0F2" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <SolidColorBrush x:Key="CtrlBorderBrush" Color="{StaticResource CtrlBorderColor}" />

    <SolidColorBrush x:Key="TextTerBrush" Color="{StaticResource TextTerColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="SwitchOffBrush" Color="{StaticResource SwitchOffColor}" />



    <!-- Cockpit-inspired blue action/icon accent; success and model state remain green -->
    <Color x:Key="IconColor">#2868E8</Color>
    <SolidColorBrush x:Key="IconBrush" Color="{StaticResource IconColor}" />
    <SolidColorBrush x:Key="IconSoftBrush" Color="{StaticResource BlueSoftColor}" />



    <!-- Embedded Inter (Assets/Fonts/*.ttf). No Segoe UI fallback in this resource. -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>



    <Style x:Key="CardBorder" TargetType="Border">

        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />

        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="18" />

        <Setter Property="SnapsToDevicePixels" Value="True" />

    </Style>



    <Style x:Key="FlatPanelButton" TargetType="Button">

        <Setter Property="Background" Value="Transparent" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"

                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>


