<UserControl x:Class="VNText.Studio.App.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Cursor="Hand" Background="Transparent"
             MouseLeftButtonUp="OnClick">
    <Border x:Name="Track" Width="52" Height="30" CornerRadius="15"
            Background="{StaticResource SwitchOffBrush}" BorderBrush="#E5E5EA" BorderThickness="1">
        <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center" />
    </Border>
</UserControl>
