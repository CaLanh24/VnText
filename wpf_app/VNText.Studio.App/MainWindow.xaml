<Window x:Class="VNText.Studio.App.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VNText.Studio.App.ViewModels"
        xmlns:conv="clr-namespace:VNText.Studio.App.Converters"
        xmlns:ctrl="clr-namespace:VNText.Studio.App.Controls"
        Title="VNText Studio"
        Width="1440" Height="920" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/vntext_studio.ico"
        Background="{DynamicResource WorkspaceCanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource UiBodySize}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StepStateToDotBrushConverter x:Key="StepDot" />
        <conv:StepStateToFontWeightConverter x:Key="StepWeight" />
        <conv:StepStateToTitleForegroundConverter x:Key="StepTitleFg" />
        <conv:StepStateToDotRingVisibilityConverter x:Key="StepDotRing" />
        <conv:TabEqualsToVisibilityConverter x:Key="TabVis" />
        <conv:TabEqualsToBackgroundConverter x:Key="TabBg" />
        <conv:BoolToPrimaryButtonStyleConverter x:Key="PrimaryBtnStyle" />
        <conv:PathToDisplayNameConverter x:Key="PathName" />
        <conv:IntToPercentConverter x:Key="Pct" />
        <conv:LogStateTextConverter x:Key="LogState" />
        <conv:CountZeroToVisibilityConverter x:Key="EmptyLogVis" />
        <conv:CountNonZeroToVisibilityConverter x:Key="LogVis" />
        <conv:StringMatchConverter x:Key="StrMatch" />
        <conv:TabEqualsToNavBackgroundConverter x:Key="NavBg" />
        <conv:TabEqualsToNavForegroundConverter x:Key="NavFg" />
        <ControlTemplate x:Key="AboutPageHeaderTemplate" TargetType="HeaderedContentControl">
            <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource UiPageTitleTextStyle}" Foreground="{DynamicResource SettingsTitleBrush}" VerticalAlignment="Center" />
        </ControlTemplate>
        <ImageBrush x:Key="BrandArtwork" ImageSource="Assets/brand-owner.png" Viewbox="0.1053,0.1013,0.7903,0.7967" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill" />
        <DataTemplate x:Key="JournalLineTemplate"><TextBlock Text="{Binding}" FontSize="{StaticResource UiBodySize}" FontWeight="Normal" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,0,0,6" /></DataTemplate>
        <!-- About/updater-only surface resources. -->
        <LinearGradientBrush x:Key="UpdaterGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2563EB" Offset="0" /><GradientStop Color="#00B5CD" Offset="1" /></LinearGradientBrush>
        <LinearGradientBrush x:Key="UpdaterReadyGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2563EB" Offset="0" /><GradientStop Color="#00B5CD" Offset="1" /></LinearGradientBrush>
        <Style x:Key="AboutDestinationStyle" TargetType="Button" BasedOn="{StaticResource AboutActionSurfaceButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="#F0F1F5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="18" UseLayoutRounding="True" SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect" Value="{x:Null}" /><Setter Property="ctrl:HoverMotion.Kind" Value="AboutCard" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="#4063ED" /><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#475569" BlurRadius="24" ShadowDepth="6" Opacity="0.12" RenderingBias="Quality" /></Setter.Value></Setter></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="AboutInfoSurfaceStyle" TargetType="Border">
            <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ctrl:HoverMotion.Kind" Value="AboutCard" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#4063ED" />
                <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#475569" BlurRadius="24" ShadowDepth="6" Opacity="0.12" RenderingBias="Quality" /></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource UiSidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="{StaticResource UiSidebarInset}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,43,0,0">
                    <Button Click="SidebarUpdate_Click" Foreground="White" FontWeight="Bold" Margin="0,0,0,16" MinHeight="40" AutomationProperties.Name="Cập nhật VNText Studio">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Cập nhật" /><Setter Property="Background" Value="{StaticResource UpdaterGradient}" /><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdatePresentation.Available, ElementName=RootWindow}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding UpdatePresentation.Ready, ElementName=RootWindow}" Value="True"><Setter Property="Content" Value="Khởi động lại" /><Setter Property="Background" Value="{StaticResource UpdaterReadyGradient}" /></DataTrigger>
                            </Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,14">
                    <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource BrandArtwork}" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VNText Studio" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource NavDividerBrush}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Grid.Row="1">

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="extract">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=extract}" />
                                <Setter Property="Tag" Value="{Binding SelectedTab, Converter={StaticResource StrMatch}, ConverterParameter=extract}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=extract}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SourceIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="18" Height="18" Margin="1,0,12,0" />
                            <TextBlock Text="Lấy text" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="translate">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=translate}" />
                                <Setter Property="Tag" Value="{Binding SelectedTab, Converter={StaticResource StrMatch}, ConverterParameter=translate}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=translate}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource TranslateIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="18" Height="18" Margin="1,0,12,0" />
                            <TextBlock Text="Dịch local" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="editcsv">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=editcsv}" />
                                <Setter Property="Tag" Value="{Binding SelectedTab, Converter={StaticResource StrMatch}, ConverterParameter=editcsv}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=editcsv}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CsvIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="18" Height="18" Margin="1,0,12,0" />
                            <TextBlock Text="Sửa CSV" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="patch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=patch}" />
                                <Setter Property="Tag" Value="{Binding SelectedTab, Converter={StaticResource StrMatch}, ConverterParameter=patch}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=patch}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PatchIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="18" Height="18" Margin="1,0,12,0" />
                            <TextBlock Text="Tạo patch" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="3,0,3,19" />
                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="journal">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=journal}" />
        <Setter Property="Tag" Value="{Binding SelectedTab, Converter={StaticResource StrMatch}, ConverterParameter=journal}" />
        <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=journal}" />
    </Style></Button.Style>
    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LogIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="18" Height="18" Margin="1,0,12,0" /><TextBlock Text="Nhật ký" /></StackPanel>
</Button>
<Button Command="{Binding NavigateTabCommand}" CommandParameter="settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=settings}" />
                                <Setter Property="Tag" Value="{Binding SelectedTab, Converter={StaticResource StrMatch}, ConverterParameter=settings}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=settings}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="18" Height="18" Margin="1,0,12,0" />
                            <TextBlock Text="Cài đặt" />
                        </StackPanel>
                    </Button>
                </StackPanel>


            </Grid>
        </Border>

        <!-- Shell-only seam: visual falloff on the canvas, no hit target or gutter change. -->
        <Border Grid.Column="1" HorizontalAlignment="Left" Width="22" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#23445169" Offset="0" />
                <GradientStop Color="#0C445169" Offset="0.48" />
                <GradientStop Color="#00445169" Offset="1" />
            </LinearGradientBrush></Border.Background>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="{StaticResource UiPageInset}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0" Margin="0,38,0,32" MinHeight="58" Style="{StaticResource StandardPageHeaderStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource UiPageTitleTextStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Hủy tác vụ" Style="{StaticResource OutlineButton}" Margin="0,0,10,0"
                            Command="{Binding CancelCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Hủy rồi thoát" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Command="{Binding CancelAndExitCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <Border Background="{DynamicResource GreenSoftBrush}" CornerRadius="12" Padding="13,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Chạy trên máy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GreenDarkBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        <Grid Grid.Row="1">
        <ScrollViewer x:Name="PageScrollViewer"
                      Style="{StaticResource OverlayAutoHideScrollViewer}"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid>

                    <!-- Extract page -->
                    <Grid x:Name="ExtractPage" Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=extract}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="ExtractConfigCard" Grid.Row="0" Style="{StaticResource CardShadowBorder}" Margin="0,0,0,24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource BlueSoftBrush}">
                                        <Path Data="{StaticResource FolderIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="17" Height="17" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Nguồn và gói dịch" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                        <TextBlock Text="Nguồn được giữ nguyên; gói dịch lưu riêng." FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="AnalyzePanel" Grid.Row="3" Style="{StaticResource SubtlePanelBorder}" Margin="0,24,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource BlueSoftBrush}">
                                                <Path Data="{StaticResource ActivityIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="16" Height="16" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Phân tích game" FontSize="{StaticResource UiBodySize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                <TextBlock Text="Kiểm tra khả năng lấy text; không sửa game." FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button x:Name="AnalyzeButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Command="{Binding AnalyzeCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource ScanIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="Phân tích" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,20,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AnalyzeStatusText}" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AnalyzeEngineSummary}" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AnalyzeScanErrorText}" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <Expander Foreground="{DynamicResource InkBrush}" Grid.Row="2" Header="Chi tiết phân tích" Margin="0,16,0,0"
                                                  IsExpanded="{Binding AnalyzeResultsExpanded, Mode=TwoWay}">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="6" Text="{Binding AnalyzeEngineDetails}" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="{Binding AnalyzeResourceCount}" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                <TextBlock Text="Tài nguyên" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="{Binding AnalyzeTextCandidateCount}" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                <TextBlock Text="Có thể là văn bản" TextWrapping="Wrap" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock Text="{Binding AnalyzePatchableCount}" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                <TextBlock Text="Có đường ghi lại; chưa kiểm patch" TextWrapping="Wrap" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="3">
                                                <TextBlock Text="{Binding AnalyzeExtractOnlyCount}" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
                                                <TextBlock Text="Chỉ lấy văn bản" TextWrapping="Wrap" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="4">
                                                <TextBlock Text="{Binding AnalyzeReviewRiskCount}" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="Cần xem lại / chưa hỗ trợ" TextWrapping="Wrap" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="5">
                                                <TextBlock Text="{Binding AnalyzeUnknownCount}" FontSize="{StaticResource UiSectionTitleSize}" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Text="Chưa xác định" TextWrapping="Wrap" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Text="Phân tích chỉ đọc nguồn; kết quả này chưa kiểm tra việc ghi bản dịch vào game."
                                                       FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource MutedBrush}"
                                                       Margin="0,16,0,0" TextWrapping="Wrap" />
                                        </Grid>
                                        </Expander>
                                        <TextBlock Grid.Row="3" Text="{Binding AnalyzeReportPath}" FontSize="{StaticResource UiCaptionSize}" Foreground="{DynamicResource SoftTextBrush}" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding AnalyzeHasReport, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                                    <TextBlock Text="Game hoặc asset" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PathDisplayBorderStyle}" AllowDrop="True" Drop="InputPathDrop">
                                            <TextBlock Text="{Binding InputDisplay}" Margin="12,0" VerticalAlignment="Center" FontSize="{StaticResource UiBodySize}"
                                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding OpenInputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource OpenIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Mở" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Command="{Binding ChooseInputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource SourceIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Chọn..." />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                                    <TextBlock Text="Thư mục xuất" FontSize="{StaticResource UiCaptionSize}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PathDisplayBorderStyle}">
                                            <TextBlock Text="{Binding OutputDisplay}" Margin="12,0" VerticalAlignment="Center" FontSize="{StaticResource UiBodySize}"
                                                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource OpenIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Mở" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Command="{Binding ChooseOutputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource FolderIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{DynamicResource BlueBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Chọn..." />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Border x:Name="ExtractOptionsPanel" Grid.Row="4" Style="{StaticResource SubtlePanelBorder}" Margin="0,24,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tuỳ chọn trích xuất" FontSize="{StaticResource UiBodySize}" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
