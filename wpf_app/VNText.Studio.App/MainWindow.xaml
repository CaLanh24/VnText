<Window x:Class="VNText.Studio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VNText.Studio.App.ViewModels"
        xmlns:conv="clr-namespace:VNText.Studio.App.Converters"
        xmlns:ctrl="clr-namespace:VNText.Studio.App.Controls"
        Title="VNText Studio"
        Width="1440" Height="920" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/vntext_studio.ico"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="MainWindow_SizeChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StepStateToDotBrushConverter x:Key="StepDot" />
        <conv:StepStateToFontWeightConverter x:Key="StepWeight" />
        <conv:StepStateToTitleForegroundConverter x:Key="StepTitleFg" />
        <conv:StepStateToDotRingVisibilityConverter x:Key="StepDotRing" />
        <conv:TabEqualsToVisibilityConverter x:Key="TabVis" />
        <conv:TabEqualsToBackgroundConverter x:Key="TabBg" />
        <conv:BoolToPrimaryButtonStyleConverter x:Key="PrimaryBtnStyle" />
        <conv:PathToDisplayNameConverter x:Key="PathName" />
        <conv:IntToPercentConverter x:Key="Pct" />
        <conv:LogStateTextConverter x:Key="LogState" />
        <conv:CountZeroToVisibilityConverter x:Key="EmptyLogVis" />
        <conv:CountNonZeroToVisibilityConverter x:Key="LogVis" />
        <conv:StringMatchConverter x:Key="StrMatch" />
        <conv:TabEqualsToNavBackgroundConverter x:Key="NavBg" />
        <conv:TabEqualsToNavForegroundConverter x:Key="NavFg" />
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,4,0,34">
                    <Border Width="35" Height="35" CornerRadius="11" Background="{StaticResource BrandDarkBrush}">
                        <Path Data="{StaticResource BrandMarkGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="White" Width="19" Height="19" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VNText Studio" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="LOCAL WORKSPACE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SoftTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" Margin="3,0,0,10" />

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="extract">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=extract}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=extract}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SourceIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="15" Height="15" Margin="1,0,8,0" />
                            <TextBlock Text="Lấy text" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="translate">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=translate}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=translate}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource TranslateIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="15" Height="15" Margin="1,0,8,0" />
                            <TextBlock Text="Dịch local" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="editcsv">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=editcsv}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=editcsv}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CsvIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="15" Height="15" Margin="1,0,8,0" />
                            <TextBlock Text="Sửa CSV" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="patch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=patch}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=patch}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PatchIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="15" Height="15" Margin="1,0,8,0" />
                            <TextBlock Text="Tạo patch" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="3,0,3,19" />
                    <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" Margin="3,0,0,10" />
                    <Border Background="{StaticResource ProjectCardBrush}" CornerRadius="12" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource IconSoftBrush}">
                                <Path Data="{StaticResource GamepadIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource MutedBrush}" Width="16" Height="16" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InputPath, Converter={StaticResource PathName}}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                <TextBlock Text="Unity project" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding NavigateTabCommand}" CommandParameter="settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Setter Property="Background" Value="{Binding SelectedTab, Converter={StaticResource NavBg}, ConverterParameter=settings}" />
                                <Setter Property="Foreground" Value="{Binding SelectedTab, Converter={StaticResource NavFg}, ConverterParameter=settings}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Width="15" Height="15" Margin="1,0,8,0" />
                            <TextBlock Text="Cài đặt" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="3,24,0,0">
                    <TextBlock Text="Phiên bản hiện tại" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding CurrentVersionDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="Phiên bản mới" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                               Visibility="{Binding GitHubUpdateVersionVisible, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding GitHubUpdateVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,2,0,0"
                               Visibility="{Binding GitHubUpdateVersionVisible, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding GitHubUpdateStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Button Content="{Binding GitHubUpdateButtonText}" AutomationProperties.Name="{Binding GitHubUpdateButtonText}"
                            Style="{StaticResource PrimaryButton}" Command="{Binding RecheckUpdateCommand}"
                            IsEnabled="{Binding GitHubUpdateButtonEnabled}"
                            Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="38,0,38,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <!-- Bottom margin trimmed so MinHeight 720 does not leave ~29px PageScrollViewer overflow (needle scrollbar). -->
            <Grid Grid.Row="0" Margin="0,26,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                        <Run Text="Workspace  /  " />
                        <Run Text="{Binding HeroTitle, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding HeroTitle}" FontSize="31" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,9,0,0" />
                    <TextBlock Text="{Binding HeroHint}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                               TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Hủy tác vụ" Style="{StaticResource OutlineButton}" Margin="0,0,10,0"
                            Command="{Binding CancelCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <Border Background="{StaticResource GreenSoftBrush}" CornerRadius="12" Padding="13,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Local mode" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        <Grid Grid.Row="1">
        <ScrollViewer x:Name="PageScrollViewer"
                      Style="{StaticResource OverlayAutoHideScrollViewer}"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid>

                    <!-- Extract page -->
                    <Grid x:Name="ExtractPage" Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=extract}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.06*" />
                            <ColumnDefinition Width="0.94*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ExtractConfigCard" Grid.Column="0" Style="{StaticResource CardShadowBorder}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GreenSoftBrush}">
                                        <Path Data="{StaticResource FolderIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="17" Height="17" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Đường dẫn" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="Game gốc và nơi xuất gói dịch." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="BẮT BUỘC" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Border x:Name="AnalyzePanel" Grid.Row="1" Style="{StaticResource SubtlePanelBorder}" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource GreenSoftBrush}">
                                                <Path Data="{StaticResource ActivityIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="16" Height="16" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Phân tích game" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="Preflight read-only trước khi lấy text." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button x:Name="AnalyzeButton" Grid.Column="2" Style="{StaticResource OutlineButton}" Command="{Binding AnalyzeCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource ScanIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                    <TextBlock Text="Phân tích" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AnalyzeStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AnalyzeScanErrorText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="12,0,0,0" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AnalyzeUnityStatus}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AnalyzeResourceCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="Tài nguyên" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding AnalyzeTextCandidateCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="Text candidate" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding AnalyzePatchableCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="Patchable obs." FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{Binding AnalyzeExtractOnlyCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="Extract-only" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="{Binding AnalyzeReviewRiskCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                                <TextBlock Text="Review / unsup." FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="5">
                                                <TextBlock Text="{Binding AnalyzeUnknownCount}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="Unknown" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="3" Text="{Binding AnalyzeReportPath}" FontSize="9" Foreground="{StaticResource SoftTextBrush}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                    <TextBlock Text="Game / asset" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PathDisplayBorderStyle}" AllowDrop="True" Drop="InputPathDrop">
                                            <TextBlock Text="{Binding InputDisplay}" Margin="12,0" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding OpenInputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource OpenIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Mở" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Command="{Binding ChooseInputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource SourceIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Chọn..." />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                    <TextBlock Text="Thư mục xuất" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource PathDisplayBorderStyle}">
                                            <TextBlock Text="{Binding OutputDisplay}" Margin="12,0" VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource OpenIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Mở" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Command="{Binding ChooseOutputCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource FolderIconGeometry}" Style="{StaticResource NavVectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="14" Height="14" Margin="0,0,7,0" />
                                                <TextBlock Text="Chọn..." />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Row="4" Style="{StaticResource SubtlePanelBorder}" Margin="0,24,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Tuỳ chọn trích xuất" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <CheckBox Grid.Row="1" Content="Tách dòng cần duyệt" IsChecked="{Binding SeparateReview, Mode=TwoWay}" Style="{StaticResource SwitchStyle}" Margin="0,13,0,0" />
                                        <StackPanel Grid.Row="2" Margin="0,13,0,0"
                                                    Visibility="{Binding RenpySdkOptionsVisible, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Game Ren'Py được nhận diện" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="Để lấy đủ lời thoại, app cần công cụ Ren'Py. Nếu chưa có, bạn có thể tải công cụ hoặc tiếp tục; khi đó một số lời thoại sẽ cần xem lại." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding RenpySdkStatus}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Style="{StaticResource OutlineButton}" Command="{Binding DownloadRenpySdkCommand}"><TextBlock Text="Tải công cụ rồi lấy text" /></Button>
                                                <Button Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Command="{Binding ChooseRenpySdkCommand}"><TextBlock Text="Chọn công cụ đã cài" /></Button>
                                                <Button Style="{StaticResource OutlineButton}" Margin="7,0,0,0" Command="{Binding ContinueWithoutRenpySdkCommand}"><TextBlock Text="Tiếp tục, lời thoại cần xem lại" /></Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="5" Margin="0,21,0,0">
                                    <TextBlock Text="Mức lọc văn bản thô" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                        <RadioButton Content="Sạch" GroupName="ExtractFilter" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,25,0"
                                                     IsChecked="{Binding ExtractLevel, Mode=TwoWay, Converter={StaticResource StrMatch}, ConverterParameter=clean}" />
                                        <RadioButton Content="Cân bằng" GroupName="ExtractFilter" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,25,0"
                                                     IsChecked="{Binding ExtractLevel, Mode=TwoWay, Converter={StaticResource StrMatch}, ConverterParameter=balanced}" />
                                        <RadioButton Content="Quét sâu" GroupName="ExtractFilter" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                                     IsChecked="{Binding ExtractLevel, Mode=TwoWay, Converter={StaticResource StrMatch}, ConverterParameter=exhaustive}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="6" Margin="0,20,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tiến trình quét" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, Converter={StaticResource Pct}}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                                 Style="{StaticResource ExtractionProgressBarStyle}" Margin="0,8,0,0" />
                                </Grid>

                                <Grid Grid.Row="7" Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProgressSubtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
