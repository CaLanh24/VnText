                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Term}" FontSize="12" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="→" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Translation}" FontSize="12" Foreground="{DynamicResource BlueBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="Xóa" Padding="8,2" MinWidth="52" MinHeight="28" Height="28" FontSize="12" VerticalAlignment="Center" Style="{StaticResource OutlineButton}"
                                            ToolTip="Xóa thuật ngữ này" Command="{Binding DataContext.RemoveGlossaryEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
