                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PatchPreflightMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0">
                                            <Run Text="Patch: " />
                                            <Run Text="{Binding PatchEligibleCount, Mode=OneWay}" />
                                            <Run Text=" hợp lệ · " />
                                            <Run Text="{Binding PatchBlockedCount, Mode=OneWay}" />
                                            <Run Text=" bị chặn" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Đóng gói patch" Style="{StaticResource PrimaryButton}" Command="{Binding RunPatchCommand}" />
                                </Grid>

                                <Border Grid.Row="4" Style="{StaticResource SubtlePanelBorder}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PatchDeliveryLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PatchInstallInstructions}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="PatchCheckCard" Grid.Column="1" Style="{StaticResource CardShadowBorder}" Margin="10,0,0,0"
                                Height="{Binding ActualHeight, ElementName=PatchConfigCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kiểm tra trước khi build" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="Mọi thứ cần sẵn sàng trước khi xuất package." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource GreenSoftBrush}" CornerRadius="8" Padding="9,5">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="CHƯA SẴN SÀNG" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PatchPreflightOk}" Value="True">
                                                            <Setter Property="Text" Value="SẴN SÀNG" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CsvValidationOk}" Value="True">
                                                            <Setter Property="Text" Value="CSV OK" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="0,22,0,0">
                                    <Border Style="{StaticResource ChecklistPanelBorder}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GreenSoftBrush}">
                                                <Path Data="{StaticResource CheckIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="15" Height="15" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="CSV / preflight" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="{Binding CsvValidationMessage}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ChecklistPanelBorder}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GreenSoftBrush}">
                                                <Path Data="{StaticResource CheckIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="15" Height="15" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Patch preflight" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="{Binding PatchPreflightMessage}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ChecklistPanelBorder}" Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource GreenSoftBrush}">
                                                <Path Data="{StaticResource CheckIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="15" Height="15" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Thư mục xuất" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text="{Binding OutputDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="2" Style="{StaticResource LogPanelBorderStyle}" Margin="0,16,0,0"
                                        MinHeight="160" VerticalAlignment="Stretch">
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                                                    Visibility="{Binding LogLines.Count, Converter={StaticResource EmptyLogVis}}">
                                            <TextBlock Text="Nhật ký patch" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="Log phiên làm việc sẽ hiện ở đây khi có hoạt động."
                                                       TextAlignment="Center" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <ScrollViewer x:Name="PatchLogScrollViewer"
                                                      Style="{StaticResource ContentPanelScrollViewer}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding LogLines.Count, Converter={StaticResource LogVis}}">
                                            <ItemsControl ItemsSource="{Binding LogLines}" Margin="12,10">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3" Background="{StaticResource SubtlePanelBrush}" CornerRadius="12" Padding="14,13" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="HỢP LỆ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" />
                                            <TextBlock Text="{Binding PatchEligibleCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="BỊ CHẶN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" />
                                            <TextBlock Text="{Binding PatchBlockedCount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TRẠNG THÁI" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SoftTextBrush}" />
                                            <TextBlock Text="{Binding StepStatusLine}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Settings page -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=settings}">
                        <ScrollViewer x:Name="SettingsScrollViewer"
                                      Style="{StaticResource OverlayAutoHideScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid MinWidth="600" Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource CardShadowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GreenSoftBrush}">
                                            <Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="18" Height="18" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Cài đặt" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="Workspace local và trạng thái công cụ." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource BlueSoftBrush}" CornerRadius="8" Padding="9,5">
                                            <TextBlock Text="LOCAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BlueBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardShadowBorder}" Margin="0,0,7,0" Padding="21,20">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Tuỳ chọn theo từng bước" FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Row="1" Text="Cách tách dòng và lọc nội dung chỉnh ở Lấy text; cách ghi đè và duyệt bản dịch chỉnh ở Dịch local." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardShadowBorder}" Margin="7,0,0,0" Padding="21,20">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Runtime" FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Grid.Row="1" Text="Trạng thái worker local." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                            <Border Grid.Row="2" Background="{StaticResource GreenSoftBrush}" CornerRadius="11" Padding="12,11" Margin="0,18,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Margin="9,0,0,0">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GreenDarkBrush}" />
                                                        <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="2" Text="Các tuỳ chọn trong quy trình được lưu tự động." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </ScrollViewer>

                    <!-- CSV editor: outside PageScrollViewer so DataGrid virtualization works -->
                    <Grid Visibility="{Binding SelectedTab, Converter={StaticResource TabVis}, ConverterParameter=editcsv}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="14,12" Margin="0,0,0,14"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CsvEditorSearchBox"
                                         Text="{Binding CsvEditorSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldTextBoxStyle}" />
                                <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="180" Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding CsvFilterOptions}"
                                          SelectedValue="{Binding CsvFilterMode, Mode=TwoWay}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label" />
                                <Button Grid.Column="2" Content="Tải lại" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                                        Command="{Binding ReloadCsvEditorCommand}" />
                                <Button Grid.Column="3" Content="Lưu thay đổi" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                        Command="{Binding SaveCsvEditorCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardShadowBorder}" Padding="22,20">
                            <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GreenSoftBrush}">
                                        <Path Data="{StaticResource CsvIconGeometry}" Style="{StaticResource VectorIconStyle}" Stroke="{StaticResource GreenBrush}" Width="18" Height="18" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="{Binding CsvEditorPathDisplay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Chỉnh sửa bản dịch trước khi đóng gói." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource GreenSoftBrush}" CornerRadius="8" Padding="9,5"
                                            Visibility="{Binding CsvEditorDirty, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="CHƯA LƯU" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenDarkBrush}" />
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Style="{StaticResource SubtlePanelBorder}" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nguồn CSV" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding CsvEditorPathDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Chọn file" Style="{StaticResource OutlineButton}" Command="{Binding OpenCsvEditorFileCommand}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Command="{Binding ClearBlockedCsvCommand}">
                                        <TextBlock Text="Xóa bản dịch lỗi" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Command="{Binding ValidateCsvEditorCommand}">
                                        <TextBlock Text="Kiểm tra" />
                                    </Button>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding RetranslateBlockedCsvCommand}">
                                        <TextBlock Text="Dịch lại dòng lỗi (CT2)" />
                                    </Button>
                                </StackPanel>

                                <Border Grid.Row="3" Style="{StaticResource SubtlePanelBorder}" Margin="0,14,0,0" Padding="11,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,7,0">
                                            <TextBlock Text="Tìm trong bản dịch" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBox x:Name="CsvBulkFindTextBox" Text="{Binding CsvBulkFind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactFieldTextBoxStyle}" Margin="0,5,0,0" ToolTip="Chỉ tìm trong cột Bản dịch" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="7,0,7,0">
                                            <TextBlock Text="Thay bằng" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBox x:Name="CsvBulkReplaceTextBox" Text="{Binding CsvBulkReplace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactFieldTextBoxStyle}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="7,0,7,0">
                                            <TextBlock Text="Phạm vi" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <ComboBox x:Name="CsvBulkScopeComboBox" ItemsSource="{Binding CsvBulkScopeOptions}" SelectedValue="{Binding CsvBulkScope, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="132" Height="32" Margin="0,5,0,0" Style="{StaticResource SettingsCombo}" />
                                        </StackPanel>
                                        <Button x:Name="CsvBulkPreviewButton" Grid.Column="3" Content="Xem trước &amp; thay thế" Style="{StaticResource OutlineButton}" Margin="7,15,7,0" Command="{Binding BulkReplaceCsvCommand}" />
                                        <Button x:Name="CsvBulkUndoButton" Grid.Column="4" Content="Undo" Style="{StaticResource OutlineButton}" Margin="0,15,0,0" Command="{Binding UndoBulkReplaceCsvCommand}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                                    <TextBlock FontSize="11" Foreground="{StaticResource SoftTextBrush}"
                                               Text="{Binding CsvBulkPreview}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource SoftTextBrush}" Margin="0,4,0,0"
                                               Text="{Binding CsvEditorValidationMessage}" TextWrapping="Wrap" />
                                </StackPanel>

                                <DataGrid Grid.Row="5" x:Name="CsvEditorGrid" Margin="0,14,0,0"
                                          Style="{StaticResource CsvDataGridStyle}"
                                          ItemsSource="{Binding CsvEditorView}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Extended"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.IsContainerVirtualizable="True"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.IsDeferredScrollingEnabled="False"
                                          MinRowHeight="32"
                                          CanUserResizeColumns="True"
                                          CanUserResizeRows="False"
                                          FontSize="12"
                                          SelectionChanged="CsvEditorGrid_SelectionChanged"
                                          CellEditEnding="CsvEditorGrid_CellEditEnding">
                                    <DataGrid.Resources>
                                        <!-- Belt-and-suspenders scoped override (same as CsvDataGridStyle.Resources). -->
                                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ContentPanelScrollBar}" />
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="KEY" Binding="{Binding Key}" IsReadOnly="True" Width="130" MinWidth="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="ToolTip" Value="{Binding Key}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="NGUYÊN BẢN" Binding="{Binding SourceText}" IsReadOnly="True" Width="2*" MinWidth="240">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="ToolTip" Value="{Binding SourceText}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="BẢN DỊCH TIẾNG VIỆT" Binding="{Binding Translation, UpdateSourceTrigger=PropertyChanged}" Width="3*" MinWidth="280">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="ToolTip" Value="{Binding Translation}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding IssueDisplay}" IsReadOnly="True" Width="180" MinWidth="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="ToolTip" Value="{Binding IssueDisplay}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="6" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CsvEditorGateStats}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CsvEditorStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
        </Grid>
        </Grid>

        <!-- Toast -->
        <Border Grid.Column="1" Panel.ZIndex="200"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,14,0,0" Padding="16,10" CornerRadius="10"
                MaxWidth="720"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="error">
                            <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="warning">
                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="info">
                            <Setter Property="Background" Value="{StaticResource BlueSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BlueBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastMessage}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <Grid x:Name="GlossaryOverlay" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Background="#990F172A" Visibility="Collapsed" Focusable="True"
              PreviewKeyDown="GlossaryOverlay_PreviewKeyDown"
              PreviewMouseDown="GlossaryOverlay_PreviewMouseDown">
            <Border Width="720" MaxHeight="610" Margin="24" Padding="22"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Thuật ngữ ưu tiên" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Chọn cách dịch muốn dùng thống nhất cho những từ thường gặp." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding GlossaryStatus}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="GlossaryCloseButton" Grid.Column="1" Content="Đóng" Style="{StaticResource OutlineButton}"
                                Margin="12,0,0,0" VerticalAlignment="Top" Click="GlossaryCloseButton_Click" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Từ trong game" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="Dịch thành" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="GlossaryTermTextBox" Grid.Row="1"
                                 Text="{Binding GlossaryTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactFieldTextBoxStyle}" Margin="0,5,5,0"
                                 ToolTip="Ví dụ: pheromones" />
                        <TextBox x:Name="GlossaryTranslationTextBox" Grid.Row="1" Grid.Column="1"
                                 Text="{Binding GlossaryTranslation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactFieldTextBoxStyle}" Margin="5,5,5,0"
                                 ToolTip="Ví dụ: mị lực" />
                        <Button x:Name="GlossaryAddButton" Grid.Row="1" Grid.Column="2" Content="Thêm"
                                Style="{StaticResource OutlineButton}" Margin="5,5,0,0"
                                Command="{Binding AddGlossaryEntryCommand}" IsDefault="True" />
                    </Grid>
                    <ListBox x:Name="GlossaryListBox" Grid.Row="2" ItemsSource="{Binding GlossaryEntries}"
                             Height="300" Margin="0,16,0,0" BorderBrush="{StaticResource LineBrush}"
                             BorderThickness="1" Background="{StaticResource SurfaceBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Term}" FontSize="12" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="→" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Translation}" FontSize="12" Foreground="{StaticResource GreenDarkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="Xóa" Padding="8,2" MinWidth="52" MinHeight="24" Height="24" FontSize="10" VerticalAlignment="Center" Style="{StaticResource OutlineButton}"
                                            ToolTip="Xóa thuật ngữ này" Command="{Binding DataContext.RemoveGlossaryEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
