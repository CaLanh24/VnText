<Project>
  <!-- Compile-only API stubs: same assembly names/versions as the Unity player's own assemblies, so the adapter references them exactly as a
       build against a real Unity install would.  Stub assemblies are never shipped; no Unity binary is needed to build the adapter. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <NoWarn>$(NoWarn);CS0660;CS0661;CS0809;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="netstandard" HintPath="$(VNTextNetStandardRef)" Private="false" />
  </ItemGroup>
</Project>
