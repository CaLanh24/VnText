<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the REAL standalone installer window (InstallerForm.cs) against a fake Ren'Py game: content-sized compact card, fixed width, right-aligned footer,
       keyboard order/Escape, dark/light tokens and contrast, per state.  Saves PNGs next to the result.  Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="..\..\wpf_app\VNText.PatchInstaller\InstallerForm.cs" Link="InstallerForm.cs" />
    <Compile Include="..\..\wpf_app\VNText.PatchInstaller\InstallerService.cs" Link="InstallerService.cs" />
    <Compile Include="..\..\wpf_app\VNText.PatchInstaller\InstallerOwnership.cs" Link="InstallerOwnership.cs" />
    <Compile Include="..\..\wpf_app\VNText.PatchInstaller\AssetInventoryPresentation.cs" Link="AssetInventoryPresentation.cs" />
  </ItemGroup>
</Project>
