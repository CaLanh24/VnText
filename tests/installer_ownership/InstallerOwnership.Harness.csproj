<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the REAL installer sources (InstallerService.cs + InstallerOwnership.cs) against fake Ren'Py game folders: install old, upgrade, uninstall,
       clean restore, tamper, torn rollback, compiled caches and the pre-existing / unreceipted Vietnamese cases.  Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Harness.cs" />
    <Compile Include="..\..\wpf_app\VNText.PatchInstaller\InstallerService.cs" Link="InstallerService.cs" />
    <Compile Include="..\..\wpf_app\VNText.PatchInstaller\InstallerOwnership.cs" Link="InstallerOwnership.cs" />
  </ItemGroup>
</Project>
